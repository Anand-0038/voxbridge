# Dubify Guardian Environment Configuration

# Gemini API Keys (comma-separated for round-robin rotation)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# Legacy single key (deprecated, use GEMINI_API_KEYS instead)
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs API Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# OpenAI TTS Configuration (optional alternative)
OPENAI_API_KEY=your_openai_api_key
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Application Settings
DEBUG=true
DEMO_MODE=false
# Real providers: gemini, openai, or elevenlabs. Use fixture only with DEMO_MODE=true.
TTS_PROVIDER=gemini
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# If true, keep ducked original audio in the output mix.
# If false, generated speech replaces the original track.
PRESERVE_ORIGINAL_AUDIO=false

# Storage Paths
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
OUTPUT_DIR=storage/outputs

# Database: local SQLite for demos, or a PostgreSQL URL for deployment
DATABASE_URL=sqlite:///storage/voxbridge.db

# Rate Limiting & Upload
MAX_UPLOAD_SIZE_MB=500
RATE_LIMIT_UPLOADS=10
RATE_LIMIT_WINDOW=60

# YouTube access
# YouTube may require an authenticated browser session for yt-dlp downloads.
# This reads cookies directly at runtime; it does not copy them into VoxBridge.
# Use one of these options, not both:
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
# YOUTUBE_COOKIES_FILE=/absolute/path/to/youtube-cookies.txt
# YOUTUBE_USER_AGENT=Mozilla/5.0 ...
# Optional yt-dlp remote JavaScript components, e.g. ejs:github.
# YOUTUBE_REMOTE_COMPONENTS=
